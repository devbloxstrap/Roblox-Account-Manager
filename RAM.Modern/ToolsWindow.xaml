<Window x:Class="RAM.Modern.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAM • Games &amp; Tools" Icon="Assets/app-icon.png"
        Width="1030" Height="745" MinWidth="820" MinHeight="560"
        Background="#0B1325" Foreground="#EFF6FF" WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <LinearGradientBrush x:Key="ActionGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#39BDFF" Offset="0"/>
            <GradientStop Color="#5168E9" Offset="0.7"/>
            <GradientStop Color="#8653CD" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ActionGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#558BE6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="BorderBrush" Value="#A5E5FF"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#253956"/>
            <Setter Property="BorderBrush" Value="#4D729E"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#F8FBFF"/>
            <Setter Property="Background" Value="#182B46"/>
            <Setter Property="BorderBrush" Value="#456B95"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#14223A"/>
            <Setter Property="BorderBrush" Value="#334C72"/>
            <Setter Property="Foreground" Value="#F8FBFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,10"/>
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#14243C"/>
            <Setter Property="BorderBrush" Value="#315278"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Window.Resources>
    <Grid Margin="23,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <Image Source="Assets/app-icon.png" Width="62" Height="62" DockPanel.Dock="Left" Margin="0,0,15,0"/>
            <StackPanel>
                <TextBlock Text="Game Explorer &amp; Account Tools" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Public servers • Favorite games • Private links • Account backups • Tools" Foreground="#A2BFDF" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
        <TabControl Grid.Row="1" x:Name="ToolTabs" Background="#0E1B30" BorderBrush="#315176" Foreground="#EFF6FF">
            <TabItem Header="Server Browser">
                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Find public game servers" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBox x:Name="ServerPlaceBox" Width="175" ToolTip="Roblox Place ID"/>
                            <Button Content="Load servers" Click="LoadServers_Click"/>
                            <Button Content="Next page" Click="NextServers_Click" Style="{StaticResource Secondary}"/>
                            <Button Content="Scan smallest (up to 5 pages)" Click="SmallServers_Click" Style="{StaticResource Secondary}"/>
                            <Button Content="Cancel scan" Click="CancelScan_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
                            <ListBox x:Name="ServersList" DisplayMemberPath="Summary" Margin="0,0,15,0" SelectionChanged="ServersList_SelectionChanged"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Selected server" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <TextBlock x:Name="ServerDetailsText" Text="Select a server to see details." Foreground="#A5C1E2" Margin="0,0,0,20"/>
                                <CheckBox x:Name="ShuffleOnJoinCheck" Content="Shuffle Job ID when joining" Foreground="#CDE5FF" Margin="0,0,0,12"/>
                                <TextBlock Text="Launch as account" Margin="0,4,0,4"/>
                                <ComboBox x:Name="ServerAccountBox" DisplayMemberPath="Handle" Margin="0,0,0,10"/>
                                <Button Content="Join selected server as account" Click="JoinServer_Click"/>
                                <Button Content="Open game's page" Click="OpenServerGame_Click" Style="{StaticResource Secondary}"/>
                                <Button Content="Favorite this game" Click="FavoriteServerGame_Click" Style="{StaticResource Secondary}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="3" Text="Server list is a read-only public API. It can be rate-limited or have restricted pagination. Join requests a new login ticket for the chosen saved account." Foreground="#8FAECD" Margin="0,12,0,0"/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Games Library">
                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Favorite and recently opened games" FontSize="20" FontWeight="Bold" Margin="0,0,0,13"/>
                        <WrapPanel Grid.Row="1">
                            <TextBox x:Name="GamePlaceBox" Width="148" ToolTip="Place ID"/>
                            <TextBox x:Name="GameNameBox" Width="220" ToolTip="Game name / label"/>
                            <Button Content="Add / remove favorite" Click="ToggleGameFavorite_Click"/>
                            <Button Content="Open game" Click="OpenLibraryGame_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="★ Favorite games" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ListBox x:Name="FavoriteGamesList" DisplayMemberPath="Name" SelectionChanged="FavoriteGame_Selected"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="↻ Recent games" FontWeight="Bold" Margin="0,0,0,10"/>
                                <ListBox x:Name="RecentGamesList" DisplayMemberPath="Name" SelectionChanged="RecentGame_Selected"/>
                                <Button Content="Clear recent history" Click="ClearRecent_Click" Style="{StaticResource Secondary}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Discover Games">
                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Discover related Roblox games" FontSize="21" FontWeight="Bold" Margin="0,0,0,10"/>
                        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="DiscoverPlaceBox" Width="190" ToolTip="Enter a game Place ID for personalized recommendations"/>
                            <Button Content="Load recommendations" Click="Recommend_Click"/>
                            <Button Content="Open Roblox charts" Click="Discover_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <ListBox Grid.Row="2" x:Name="RecommendedGamesList" DisplayMemberPath="Summary"/>
                        <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                            <Button Content="Open selected game" Click="OpenRecommendation_Click"/>
                            <Button Content="Favorite selected game" Click="FavoriteRecommendation_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Private Servers">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Private / VIP server links" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Paste an official Roblox private server link. It will open in your default browser and Roblox will handle authentication." Foreground="#A1BCDC" Margin="0,0,0,18"/>
                        <TextBox x:Name="PrivateLinkBox" MinWidth="400" Height="45" ToolTip="https://www.roblox.com/share?..."/>
                        <Button Content="Open private server" HorizontalAlignment="Left" Click="OpenPrivate_Click"/>
                        <TextBlock Text="Only links hosted on roblox.com or its subdomains are allowed. Never share authentication tokens or cookies." Foreground="#8DAED4" Margin="0,16,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Account Utilities">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Account &amp; game shortcuts" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TextBlock Text="Official Roblox webpages only. These shortcuts use your existing browser session, not a selected RAM profile session." Foreground="#A4BDDF" Margin="0,0,0,18"/>
                        <WrapPanel>
                            <Button Content="Quick Login" Click="QuickLogin_Click"/>
                            <Button Content="Account Settings" Click="AccountSettings_Click"/>
                            <Button Content="Privacy Settings" Click="Privacy_Click" Style="{StaticResource Secondary}"/>
                            <Button Content="Security Settings" Click="Security_Click" Style="{StaticResource Secondary}"/>
                            <Button Content="Avatar Editor" Click="Avatar_Click" Style="{StaticResource Secondary}"/>
                            <Button Content="Discover Games" Click="Discover_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <TextBlock Text="Account-specific browser (isolated Edge profile)" FontSize="16" FontWeight="Bold" Margin="0,18,0,10"/>
                        <TextBlock Text="Select a saved RAM profile. Sign in manually in its isolated Edge window; passwords and browser cookies stay inside Edge." Foreground="#A4BDDF" Margin="0,0,0,10"/>
                        <WrapPanel><ComboBox x:Name="UtilityAccountBox" DisplayMemberPath="Username" Width="215" Margin="0,0,12,12"/>
                            <Button Content="Open selected account browser" Click="SelectedBrowser_Click"/>
                            <Button Content="Profile" Click="SelectedProfile_Click" Style="{StaticResource Secondary}"/>
                            <Button Content="Security" Click="SelectedSecurity_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <TextBlock Text="Open a Roblox group" FontSize="16" FontWeight="Bold" Margin="0,18,0,12"/>
                        <WrapPanel>
                            <TextBox x:Name="GroupIdBox" Width="180" ToolTip="Roblox group ID"/>
                            <Button Content="Open group page" Click="OpenGroup_Click"/>
                        </WrapPanel>
                        <TextBlock Text="For account switching, return to the main window's verified desktop-session workflow. These browser buttons do not change desktop login sessions." Foreground="#A4BDDF" Margin="0,15,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Universe &amp; Outfits">
                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Public Roblox universe and outfit data" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
                        <WrapPanel Grid.Row="1">
                            <TextBox x:Name="UniversePlaceBox" Width="170" ToolTip="Place ID"/>
                            <Button Content="View universe" Click="Universe_Click"/>
                            <TextBox x:Name="OutfitUserBox" Width="170" ToolTip="User ID"/>
                            <Button Content="Get public outfits" Click="Outfits_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="2" x:Name="UniverseInfoText" Foreground="#C8DEF9" Text="Enter a Place ID for universe information, or a User ID for their publicly available outfits." Margin="0,10,0,14"/>
                        <ListBox Grid.Row="3" x:Name="OutfitsList"/>
                    </Grid>
                </Border>
            </TabItem>
            <TabItem Header="Quick Join">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Random Public Server / Job ID Shuffle" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Choose a genuine public server from a bounded API scan. No random or invalid Job IDs are generated. This does not launch multiple Roblox clients." Foreground="#A4BDDF" Margin="0,0,0,16"/>
                        <WrapPanel>
                            <TextBox x:Name="ShufflePlaceBox" Width="180" ToolTip="Roblox Place ID"/>
                            <TextBox x:Name="ShuffleMaxPlayersBox" Width="160" Text="" ToolTip="Optional maximum current players (leave blank for any non-full server)"/>
                            <Button Content="Shuffle public server" Click="ShuffleServer_Click"/>
                            <Button Content="Join shuffled server as account" Click="JoinShuffled_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <TextBlock Text="Account for shuffled server" Margin="0,9,0,5"/>
                        <ComboBox x:Name="ShuffleAccountBox" DisplayMemberPath="Handle" Width="260" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ShuffleResultText" Text="No server selected." FontSize="15" TextWrapping="Wrap" Foreground="#CFE5FF" Margin="0,8,0,14"/>
                        <Button Content="Copy selected Job ID" Click="CopyShuffled_Click" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/>
                        <TextBlock Text="A fresh ticket is requested for the account selected above. Roblox determines whether the game/server join succeeds." Foreground="#9DBAD9" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Player Lookup">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Public Player Lookup" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Look up public Roblox usernames and user IDs. Private presence, hidden servers and disabled joins are not exposed." Foreground="#A4BDDF" Margin="0,0,0,16"/>
                        <WrapPanel>
                            <TextBox x:Name="PlayerUsernameBox" Width="240" ToolTip="Enter Roblox username"/>
                            <Button Content="Find public profile" Click="FindPlayer_Click"/>
                            <Button Content="Open official profile" Click="OpenFoundProfile_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <TextBlock x:Name="PlayerResultText" Text="Enter a username to begin." FontSize="16" Foreground="#D7E9FF" Margin="0,15,0,0"/>
                        <TextBlock Text="This is a privacy-respecting alternative to the original hidden-player finder. It does not identify a private player's current server." Foreground="#92AFCC" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Sessions &amp; Safety">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Session Health, Passwords &amp; Verification" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="RAM never records typed Roblox passwords. Use Edge's built-in password manager inside each account's isolated browser profile." Foreground="#B6D1F0" Margin="0,0,0,16"/>
                        <WrapPanel>
                            <Button Content="Audit encrypted account logins" Click="AuditSessions_Click"/>
                            <Button Content="Verify current desktop session" Click="HealthCheck_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <TextBlock x:Name="HealthResultText" Text="Account logins are encrypted locally. Verify them individually before launching." Foreground="#D7E9FF" Margin="0,4,0,15"/>
                        <TextBlock Text="Choose account for secure browser login" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <ComboBox x:Name="SessionAccountBox" DisplayMemberPath="Username" Width="225" Margin="0,0,12,12"/>
                            <Button Content="Separate Edge login (manual, not captured)" Click="OpenSafeLogin_Click"/>
                            <Button Content="Manage Edge passwords" Click="ManageBrowserPasswords_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <TextBlock Text="CAPTCHA and 2FA are completed directly on the official Roblox login page. Automatic cookie/token refreshing, CAPTCHA bypass and password interception are not supported." Foreground="#A9C7E8" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Header="Account Data">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="Account import, export and backup" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <TextBlock Text="Export and import account metadata only (username, ID, display name, group, notes). Session cookies are deliberately excluded." Foreground="#ABC5E6" Margin="0,0,0,18"/>
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Export profiles (JSON)" Click="Export_Click"/>
                            <Button Content="Import profiles (JSON)" Click="Import_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,15">
                            <Button Content="Import bulk CSV" Click="ImportCsv_Click" Style="{StaticResource Secondary}"/>
                            <Button Content="Open data directory" Click="OpenData_Click" Style="{StaticResource Secondary}"/>
                        </WrapPanel>
                        <TextBlock Text="CSV format: Username,UserId,DisplayName,Group,Note. Import merges non-duplicate profiles and never overwrites existing sessions." Foreground="#8CABCF"/>
                        <TextBlock Text="Do NOT import username:password lists, raw cookies, or plaintext session tokens into this tool." Foreground="#E6BAA8" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="#152845" BorderBrush="#31517B" BorderThickness="1" CornerRadius="12" Padding="13,11" Margin="0,13,0,0">
            <TextBlock x:Name="ToolsStatusText" Foreground="#D6EAFF" Text="Ready. All data is stored locally."/>
        </Border>
    </Grid>
</Window>
