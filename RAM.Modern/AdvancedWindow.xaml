<Window x:Class="RAM.Modern.AdvancedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAM 4.0 • Advanced Controls" Width="930" Height="770" MinWidth="740" MinHeight="600"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Icon="Assets/app-icon.png"
        Foreground="#EAF5FF" Background="#0B1527">
    <Window.Resources>
        <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A2944" Offset="0"/><GradientStop Color="#11213A" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Accent" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2CB7E8" Offset="0"/><GradientStop Color="#6656D9" Offset="1"/>
        </LinearGradientBrush>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="17,11"/><Setter Property="Margin" Value="0,3,10,7"/>
            <Setter Property="Foreground" Value="#FAFCFF"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#5F94D8"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="shape" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="shape" Property="BorderBrush" Value="#B6E9FF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#142843"/>
            <Setter Property="BorderBrush" Value="#4A719B"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,5,10,12"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,9,0,9"/><Setter Property="Foreground" Value="#E5F2FF"/><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="16,11"/><Setter Property="FontSize" Value="14"/></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="Assets/app-icon.png" Width="56" Height="56" Margin="0,0,17,0"/>
            <StackPanel Grid.Column="1"><TextBlock Text="Advanced controls" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="Watcher • FPS settings • Private developer API • Account controls" Foreground="#9BB8D9" FontSize="13" Margin="0,6,0,0"/></StackPanel>
        </Grid>
        <TabControl Grid.Row="1" Background="#101D33" Foreground="#F6FAFF" BorderBrush="#42618D">
            <TabItem Header="Roblox Watcher">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="{StaticResource Panel}" Padding="22"><StackPanel>
                    <TextBlock Text="Process monitoring" FontSize="19" FontWeight="Bold" Margin="0,0,0,9"/>
                    <TextBlock Text="Monitor the installed Roblox Player process. Optional relaunch triggers only after a running client exits; it reads recent logs for a best-effort disconnect signal, but Roblox provides no guaranteed AFK-kick detection." Foreground="#BCD0E9" Margin="0,0,0,15"/>
                    <CheckBox x:Name="WatcherEnabledCheck" Content="Enable Roblox process watcher"/>
                    <CheckBox x:Name="RelaunchCheck" Content="Opt-in: request relaunch when Roblox exits unexpectedly or manually"/>
                    <CheckBox x:Name="NotificationsCheck" Content="Show status notifications in RAM"/>
                    <CheckBox x:Name="RequireDisconnectCheck" Content="Only relaunch after recent disconnect-like log signal (recommended)"/>
                    <Button Content="Check recent disconnect signal" Click="CheckLogSignal_Click" HorizontalAlignment="Left"/>
                    <TextBlock Text="Optional Place ID to open on relaunch (0 = launch Roblox desktop)" Margin="0,18,0,4"/>
                    <TextBox x:Name="RelaunchPlaceBox" Width="220" HorizontalAlignment="Left"/>
                    <TextBlock Text="Safety limit: at most three relaunch attempts per hour, with five minutes between attempts. Watcher runs only while RAM is open." Foreground="#9FBDE2" Margin="0,14,0,15"/>
                    <Button Content="Check running Roblox processes" Click="CheckProcesses_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="WatcherCountText" Text="Process count not yet checked" Foreground="#C0D8F5"/>
                </StackPanel></Border></ScrollViewer>
            </TabItem>
            <TabItem Header="FPS controls">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="{StaticResource Panel}" Padding="22"><StackPanel>
                    <TextBlock Text="Roblox maximum framerate" FontSize="19" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Reads/writes Roblox's existing FramerateCap XML setting where available. Presets from 30 to 240 FPS are offered. Roblox may override file-based changes. No FastFlag injection or unsupported uncapping." Foreground="#BCD0E9" Margin="0,0,0,15"/>
                    <ComboBox x:Name="FpsPresetBox" Width="180" HorizontalAlignment="Left" SelectedIndex="0" Margin="0,0,0,12">
                        <ComboBoxItem Content="30"/><ComboBoxItem Content="60"/><ComboBoxItem Content="90"/><ComboBoxItem Content="120"/><ComboBoxItem Content="144"/><ComboBoxItem Content="165"/><ComboBoxItem Content="240"/>
                    </ComboBox>
                    <WrapPanel><Button Content="Read current FPS cap" Click="ReadFps_Click"/><Button Content="Apply selected FPS cap" Click="ApplyFps_Click"/><Button Content="Restore original backup" Click="RestoreFps_Click"/></WrapPanel>
                    <TextBlock x:Name="FpsStatusText" Text="Close Roblox before changing settings." Foreground="#B4D9F5" Margin="0,16,0,0"/>
                    <TextBlock Text="Roblox may overwrite local settings during updates. If its XML format changes, change the framerate in Roblox's own Settings menu." Foreground="#91ACC9" Margin="0,16,0,0"/>
                </StackPanel></Border></ScrollViewer>
            </TabItem>
            <TabItem Header="Local Developer API">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="{StaticResource Panel}" Padding="22"><StackPanel>
                    <TextBlock Text="Authenticated localhost API" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Disabled by default. Available only on 127.0.0.1, protected by a random bearer token. No cookies, passwords or saved sessions are exposed." Foreground="#BCD0E9" Margin="0,0,0,13"/>
                    <CheckBox x:Name="ApiEnabledCheck" Content="Enable local API"/>
                    <TextBlock Text="Port (1024–65535)" Margin="0,14,0,4"/>
                    <TextBox x:Name="ApiPortBox" Width="180" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="DeveloperModeCheck" Content="Enable developer mode (shows advanced configuration; no insecure actions)"/>
                    <WrapPanel Margin="0,8,0,0"><Button Content="Copy API token" Click="CopyToken_Click"/><Button Content="Rotate API token" Click="RotateToken_Click"/><Button Content="Copy API example" Click="ApiExample_Click"/></WrapPanel>
                    <TextBlock Text="GET /v1/status · GET /v1/profiles · POST /v1/open-game/{placeId} · POST /v1/open-profile/{userId} · POST /v1/desktop/launch · POST /v1/account-browser/{profileId}. Bearer token required." Foreground="#BBD3F2" Margin="0,10,0,5"/>
                    <TextBlock x:Name="ApiStatusText" Foreground="#93C4EF" Text="API is stopped."/>
                </StackPanel></Border></ScrollViewer>
            </TabItem>
            <TabItem Header="Encrypted backups">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="{StaticResource Panel}" Padding="22"><StackPanel>
                    <TextBlock Text="Password-encrypted portable backup" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="AES-256-GCM + PBKDF2-SHA256 protects profile metadata (usernames, groups, notes, favorites, preferred games). Roblox sessions, cookies and browser data are never included." Foreground="#BCD0E9" Margin="0,0,0,15"/>
                    <TextBlock Text="Backup password (minimum 12 characters for export)" Foreground="#E5F2FF"/>
                    <PasswordBox x:Name="BackupPasswordBox" Background="#142843" Foreground="White" BorderBrush="#4A719B" Padding="11,9" Margin="0,8,0,15"/>
                    <WrapPanel><Button Content="Export encrypted backup" Click="ExportEncrypted_Click"/><Button Content="Import encrypted backup" Click="ImportEncrypted_Click"/></WrapPanel>
                    <TextBlock x:Name="BackupStatusText" Foreground="#A7D7FF" Margin="0,16,0,0" Text="Keep the password safe. It cannot be reset or recovered."/>
                </StackPanel></Border></ScrollViewer>
            </TabItem>
            <TabItem Header="Themes &amp; Groups">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="{StaticResource Panel}" Padding="22"><StackPanel>
                    <TextBlock Text="Appearance" FontSize="19" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBlock Text="Change the accent for all open RAM windows. Custom accepts an RGB hex color." Foreground="#BCD0E9" Margin="0,0,0,12"/>
                    <ComboBox x:Name="ThemePresetBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <ComboBoxItem Content="Aurora"/><ComboBoxItem Content="Ocean"/><ComboBoxItem Content="Amethyst"/>
                        <ComboBoxItem Content="Ember"/><ComboBoxItem Content="Emerald"/><ComboBoxItem Content="Custom"/>
                    </ComboBox>
                    <TextBlock Text="Custom accent (#RRGGBB)" Margin="0,3,0,4"/>
                    <TextBox x:Name="CustomAccentBox" Width="190" HorizontalAlignment="Left"/>
                    <Button Content="Preview theme" Click="PreviewTheme_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ThemeStatusText" Foreground="#A7D7FF" Margin="0,8,0,20"/>
                    <Separator Background="#42618D" Margin="0,0,0,18"/>
                    <TextBlock Text="Group priorities" FontSize="19" FontWeight="Bold" Margin="0,0,0,9"/>
                    <TextBlock Text="Assign a number 0–999. Lower-numbered groups appear first. The number is hidden on profile cards; accounts within groups use manual SortOrder." Foreground="#BCD0E9" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <TextBox x:Name="PriorityGroupBox" Width="220" ToolTip="Existing group name"/>
                        <TextBox x:Name="PriorityNumberBox" Width="110" ToolTip="0 to 999"/>
                        <Button Content="Apply group priority" Click="ApplyGroupPriority_Click"/>
                        <Button Content="Remove priority" Click="RemoveGroupPriority_Click"/>
                    </WrapPanel>
                    <ListBox x:Name="GroupPrioritiesList" Background="#12213C" Foreground="White" Height="140" Margin="0,6,0,10" SelectionChanged="GroupPriorities_SelectionChanged"/>
                    <TextBlock x:Name="GroupSortStatusText" Foreground="#A7D7FF"/>
                </StackPanel></Border></ScrollViewer>
            </TabItem>
            <TabItem Header="Account controls">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><Border Background="{StaticResource Panel}" Padding="22"><StackPanel>
                    <TextBlock Text="Roblox client controls" FontSize="19" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Supported OS-level operations only. Remote in-game actions require an authorized game-side integration and are not included." Foreground="#BCD0E9" Margin="0,0,0,15"/>
                    <WrapPanel><Button Content="Open Roblox desktop" Click="OpenRoblox_Click"/><Button Content="Open selected account's preferred game" Click="OpenPreferred_Click"/><Button Content="Close Roblox Player" Click="CloseRoblox_Click"/></WrapPanel>
                    <TextBlock Text="Closing Roblox will end the current gameplay. Any unsaved in-game progress may be lost. Explicit confirmation is required." Foreground="#F0C0B9" Margin="0,15,0,10"/>
                    <Button Content="Export safe diagnostics report" Click="ExportDiagnostics_Click" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="ControlsStatusText" Foreground="#A7D7FF"/>
                </StackPanel></Border></ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Settings are saved locally. Auto-updater and multi-instance launching are excluded." Foreground="#9CB9D8" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Save settings" Click="SaveSettings_Click"/><Button Content="Close" Click="Close_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
