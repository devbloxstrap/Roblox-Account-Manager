<Window x:Class="RAM.Modern.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Roblox Account Manager 4.0 Preview" Width="1080" Height="710" MinWidth="830" MinHeight="550" Background="#101725" Foreground="#F0F3F8" WindowStartupLocation="CenterScreen">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,9,0"/><Setter Property="Background" Value="#283956"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="Background" Value="#202C40"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#465775"/><Setter Property="CaretBrush" Value="White"/></Style>
 <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,5"/></Style>
</Window.Resources>
<Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Grid.Row="0" Margin="0,0,0,20"><TextBlock Text="ROBLOX ACCOUNT MANAGER" FontSize="24" FontWeight="Bold"/><TextBlock Text="4.0 Preview · Windows 10 / 11 · Account profiles and official Roblox login" Foreground="#9BAFCB"/></StackPanel>
 <DockPanel Grid.Row="1" Margin="0,0,0,15"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Roblox login" Click="Login_Click"/><Button Content="Roblox home" Click="Home_Click"/><Button Content="Open data folder" Click="Folder_Click"/></StackPanel><TextBox x:Name="SearchBox" Width="280" TextChanged="Search_Changed" ToolTip="Search accounts by name, group, notes"/></DockPanel>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
 <Border BorderBrush="#35445C" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,14,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Saved accounts" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/><ListBox x:Name="AccountsList" SelectionChanged="Account_Selected" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14"/></DockPanel></Border>
 <Border Grid.Column="1" BorderBrush="#35445C" BorderThickness="1" CornerRadius="9" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
 <TextBlock Text="Account details" FontSize="17" FontWeight="Bold" Margin="0,0,0,14"/>
 <TextBlock Text="Username"/><TextBox x:Name="UsernameBox" Margin="0,0,0,13"/>
 <TextBlock Text="Display name"/><TextBox x:Name="DisplayBox" Margin="0,0,0,13"/>
 <TextBlock Text="Roblox user ID (optional)"/><TextBox x:Name="IdBox" Margin="0,0,0,13"/>
 <TextBlock Text="Group"/><TextBox x:Name="GroupBox" Text="General" Margin="0,0,0,13"/>
 <TextBlock Text="Notes"/><TextBox x:Name="NoteBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,13"/>
 <CheckBox x:Name="FavoriteBox" Content="Favorite" Foreground="White" Margin="0,0,0,17"/>
 <WrapPanel Margin="0,0,0,16"><Button Content="Save account" Click="Save_Click"/><Button Content="New" Click="New_Click"/><Button Content="Delete" Click="Delete_Click"/></WrapPanel>
 <TextBlock Text="Session management (Windows user only)" FontWeight="Bold" Margin="0,0,0,10"/>
<WrapPanel Margin="0,0,0,14"><Button Content="Save current session" Click="SaveSession_Click"/><Button Content="Restore selected session" Click="RestoreSession_Click"/></WrapPanel>
<TextBlock Text="Close Roblox completely before saving/restoring. A restored session may be expired; use official login if requested." TextWrapping="Wrap" Foreground="#B9C6D8" Margin="0,0,0,16"/>
<TextBlock Text="Open selected profile or a game" FontWeight="Bold" Margin="0,0,0,10"/>
 <WrapPanel Margin="0,0,0,9"><Button Content="View Roblox profile" Click="Profile_Click"/><Button Content="Open Roblox login" Click="Login_Click"/></WrapPanel>
 <TextBlock Text="Place ID"/><TextBox x:Name="PlaceBox" Margin="0,0,0,9"/><Button Content="Open game in Roblox" HorizontalAlignment="Left" Click="Game_Click"/>
 </StackPanel></ScrollViewer></Border>
 </Grid>
 <TextBlock Grid.Row="3" x:Name="StatusText" Foreground="#A8B7CA" Margin="0,14,0,0" Text="Stored sessions are encrypted for your Windows user. Roblox can revoke them; restore never bypasses login verification."/>
</Grid></Window>
